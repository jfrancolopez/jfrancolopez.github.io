---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProfilePhoto from '../../components/ProfilePhoto.astro';
import { resume } from '../../data/resume.js';
---
<BaseLayout
  title={`Resume | ${resume.name}`}
  description={`Resume for ${resume.name}: platform and DevOps engineer and IT infrastructure leader based in Raleigh-Durham, NC.`}
>
  <header class="page-header resume-header">
    <span class="eyebrow">resume</span>
    <h1>
      {resume.headline.split(' | ')[0]}
      {resume.headline.split(' | ')[1] && <span class="headline-sub">{resume.headline.split(' | ')[1]}</span>}
    </h1>
    <p class="resume-meta">{resume.tagline}</p>
    <p class="resume-meta">{resume.location} · {resume.availability}</p>
  </header>

  <section class="resume-intro" aria-label="Resume introduction">
    <div class="resume-intro-copy">
      <p class="lead">{resume.summary}</p>
      <div class="actions">
        <a class="button primary" href="/FrancoLopez-Resume.pdf" download>Download PDF</a>
        <a class="button" href={`mailto:${resume.contact.email}`}>Email me</a>
        <a class="button" href={`https://${resume.contact.linkedin}`} target="_blank" rel="noopener noreferrer">LinkedIn</a>
        <a class="button" href={`https://${resume.contact.github}`} target="_blank" rel="noopener noreferrer">GitHub</a>
      </div>
    </div>
    <ProfilePhoto />
  </section>

  <article class="content">
    <h2>Skills</h2>
    <ul class="skills-list">
      {resume.skills.map((skill) => (
        <li><strong>{skill.label}:</strong> {skill.items.join(', ')}</li>
      ))}
    </ul>

    <h2>Experience</h2>
    {resume.experience.map((job) => (
      <section class="experience-entry">
        <h3>{job.company} · {job.role}{job.scope && ` (${job.scope})`}</h3>
        {job.companyContext && <p class="company-context"><em>{job.companyContext}</em></p>}
        <p class="job-meta">{job.location} · {job.dates}</p>
        <ul>
          {job.bullets.map((bullet) => <li>{typeof bullet === 'string' ? bullet : bullet.text}</li>)}
        </ul>
        {job.stack && (
          <p class="stack-line"><strong>Stack:</strong> {job.stack.join(' · ')}</p>
        )}
      </section>
    ))}

    <h2>Projects</h2>
    {resume.projects.map((project) => (
      <section class="project-entry">
        <h3>
          {project.url ? (
            <a href={`https://${project.url}`} target="_blank" rel="noopener noreferrer">{project.name}</a>
          ) : (
            project.name
          )}
        </h3>
        <p>{project.description}</p>
        {project.stack && (
          <p class="stack-line"><strong>Stack:</strong> {project.stack.join(' · ')}</p>
        )}
        {project.page && <p><a href={project.page}>Read the project write-up →</a></p>}
      </section>
    ))}

    <h2>Certifications &amp; Training</h2>
    <ul class="cert-list">
      {resume.certifications.map((item) => (
        <li>
          <strong>{item.title}</strong> — {item.issuer} <span class="cert-status">({item.date})</span>
        </li>
      ))}
    </ul>

    <h2>Education</h2>
    <ul class="cert-list">
      {resume.education.map((item) => (
        <li>
          <strong>{item.title}</strong> — {item.issuer} <span class="cert-status">({item.date})</span>
        </li>
      ))}
    </ul>

    <h2>Currently Learning</h2>
    <ul>
      {resume.currentlyLearning.map((item) => <li>{item}</li>)}
    </ul>

    <h2>Languages</h2>
    <p>{resume.languages}.</p>
  </article>
</BaseLayout>
